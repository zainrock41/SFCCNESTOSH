<?xml version="1.0"?>
<form xmlns="http://www.demandware.com/xml/form/2008-04-19" secure="false">
	<group formid="customer">
		<field 
			formid="firstname" 
			label="label.input.firstname.profile" 
			mandatory="true" 
			max-length="50"
			missing-error="error.message.required" 
			range-error="error.message.50orless" 
			type="string" />

		<field 
			formid="lastname" 
			label="label.input.lastname.profile" 
			mandatory="true" 
			max-length="50" 
			missing-error="error.message.required"
			range-error="error.message.50orless" 
			type="string" />

		<field 
			formid="dateofbirth" 
			label="label.input.dateofbirth.profile" 
			mandatory="true" 
			max-length="10" 
			missing-error="error.message.required.dob"
			parse-error="error.message.invalid.dob" 
			value-error="error.message.invalid.dob" 
			regexp="^(0[1-9]|[12][0-9]|3[01])-(0[1-9]|1[0-2])-\d{4}$"
			type="string" />

		<field 
			formid="phone"
			label="label.input.phone.profile"
			mandatory="true"
			max-length="14"
			regexp="^\(\d{3}\) \d{3}-\d{4}$"
			missing-error="error.message.required.phone"
			parse-error="error.message.invalid.phone"
			value-error="error.message.invalid.phone"
			type="string"/> 

		<field
			formid="email" 
			label="label.input.email.profile" 
			mandatory="true" 
			max-length="50" 
			missing-error="error.message.required"
			parse-error="error.message.parse.email.profile.form"
			range-error="error.message.50orless"
			regexp="^[\w.%+\-]+@[\w.\-]+\.\w{2,}$" 
			value-error="ValueErrorText"
			type="string"/> 

		<field 
			formid="emailconfirm"
			label="label.input.emailconfirm.profile"
			mandatory="true"
			max-length="50"
			missing-error="error.message.required"
			parse-error="error.message.parse.email.profile.form"
			range-error="error.message.50orless"
			regexp="^[\w.%+\-]+@[\w.\-]+\.\w{2,}$"
			value-error="ValueErrorText"
			type="string"/> 
			
		<field 
			formid="addtoemaillist" 
			label="description.checkbox.emailsignup.profile"  
			type="boolean"/>
	</group>
	
	<group formid="login">
		<field 
			formid="password" 
			label="label.input.password.profile" 
			mandatory="true" 
			min-length="8" 
			max-length="255" 
			range-error="error.message.8_255characters" 
			missing-error="error.message.required" 
			type="string" />
			
		<field 
			formid="passwordconfirm" 
			label="label.input.passwordconfirm.profile" 
			mandatory="true" 
			min-length="8" 
			max-length="255" 
			range-error="error.message.8_255characters" 
			missing-error="error.message.required" 
			type="string" />
			
		<field 
			formid="currentpassword" 
			label="label.input.currentpassword.profile" 
			mandatory="true" 
			min-length="8" 
			max-length="255" 
			range-error="error.message.8_255characters" 
			missing-error="error.message.required" 
			type="string" />
			
		<group formid="newpasswords">
			<field 
				formid="newpassword" 
				label="label.input.newpassword.profile" 
				mandatory="true" 
				min-length="8" 
				max-length="255" 
				range-error="error.message.8_255characters" 
				missing-error="error.message.required" 
				type="string" />
				
			<field 
				formid="newpasswordconfirm" 
				label="label.input.newpasswordconfirm.profile" 
				mandatory="true" 
				min-length="8" 
				max-length="255" 
				range-error="error.message.8_255characters" 
				missing-error="error.message.required" 
				type="string" />
		</group>
	</group>
</form>

