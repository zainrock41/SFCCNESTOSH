            <attribute-definition attribute-id="dateOfBirth">
                <display-name xml:lang="x-default">Date of Birth</display-name>
                <description xml:lang="x-default">Customer Date of Birth (DOB) captured during registration</description>
                <type>date</type>
                <mandatory-flag>false</mandatory-flag>
                <visible-flag>true</visible-flag>
                <searchable-flag>false</searchable-flag>
            </attribute-definition>
            <attribute-definition attribute-id="phoneNumber">
                <display-name xml:lang="x-default">Phone Number</display-name>
                <description xml:lang="x-default">Customer Phone Number captured during registration</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <visible-flag>true</visible-flag>
                <searchable-flag>false</searchable-flag>
            </attribute-definition>
        </custom-attribute-definitions>
        <group-definitions>
            <attribute-group group-id="Custom">
                <display-name xml:lang="x-default">Custom Profile Attributes</display-name>
                <attribute attribute-id="dateOfBirth"/>
